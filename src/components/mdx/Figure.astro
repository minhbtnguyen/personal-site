---
/* Line chart inside an experiment's body. Takes the same fields as an experiment's `figure`.
   Usage: <Figure title="Latency" caption="..." chart={{ x: [...], yMax: 100, yStep: 20, series: [...] }} /> */
import type { Experiment } from '../../lib/content';
import { figureHTML } from '../../lib/render';

type Props = NonNullable<Experiment['data']['figure']>;
---
<Fragment set:html={figureHTML(Astro.props, null, true)} />
