---
/* Project card, used on the homepage row and the Projects catalog. */
import DraftBadge from './DraftBadge.astro';
import More from './More.astro';
import { projectUrl, type Project } from '../lib/content';
import { monogram, statusClass } from '../lib/render';

interface Props { project: Project }
const { project } = Astro.props;
const p = project.data;
---
<article class="pcard" data-cat={p.categories.join('|')}>
  <div class="pcard-visual ink" set:html={monogram(p.name)} />
  <div class="pcard-body">
    <p class="kicker">{p.categories.join(' · ')}</p>
    <h2><a href={projectUrl(project.id)}>{p.name}</a><DraftBadge draft={p.publish === 'Draft'} /></h2>
    <p class="t">{p.tagline}</p>
    <div class="meta">
      <span class:list={['status', statusClass(p.status)]}><i></i>{[p.status, p.year].filter(Boolean).join(' · ')}</span>
      {p.links?.source && <More href={p.links.source} label="Source" />}
      {p.links?.video && <More href={p.links.video} label="Demo video" />}
    </div>
  </div>
</article>
