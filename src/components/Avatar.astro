---
/* Owner photo in the About section, or an initials monogram when no photo is set. */
import { SITE } from '../data/site';
import { asset } from '../lib/content';

const o = SITE.owner;
---
{o.photo
  ? <img class="about-photo" src={asset(o.photo)} alt={`Portrait of ${o.name}`}>
  : <span class="about-photo mono" aria-hidden="true">{o.initials}</span>}
