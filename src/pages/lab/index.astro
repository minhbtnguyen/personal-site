---
import Base from '../../layouts/Base.astro';
import DraftBadge from '../../components/DraftBadge.astro';
import ComingSoon from '../../components/ComingSoon.astro';
import PageHero from '../../components/PageHero.astro';
import Segmented from '../../components/Segmented.astro';
import { SITE } from '../../data/site';
import { EXPERIMENT_TYPES } from '../../content.config';
import { getExperiments, hasBody, experimentHref, type Experiment } from '../../lib/content';
import { CHEV, EXT, extAttrs, fmtShort, yearOf } from '../../lib/render';

const experiments = await getExperiments();
// A tab per label some experiment uses, in EXPERIMENT_TYPES order; hidden until there are two.
const used = new Set(experiments.map(w => w.data.type));
const types = EXPERIMENT_TYPES.filter(t => used.has(t));
const years: { y: number; items: Experiment[] }[] = [];
for (const p of experiments) {
  const y = yearOf(p.data.date);
  let g = years.find(x => x.y === y);
  if (!g) { g = { y, items: [] }; years.push(g); }
  g.items.push(p);
}
const plural = (n: number) => `${n} ${n === 1 ? 'experiment' : 'experiments'}`;
---
<Base title="Lab" description={SITE.labPage.intro} active="lab">
<main>
  <PageHero title={SITE.labPage.title} intro={SITE.labPage.intro} />
  {experiments.length === 0 ? <div class="tl"><ComingSoon text="Experiments are on the way." /></div> : <Fragment>
  <div class="toolbar">
    {types.length > 1 ? <Segmented name="type" values={types} label="Filter experiments by type" /> : <span></span>}
    <span class="count" id="count" aria-live="polite">{plural(experiments.length)}</span>
  </div>
  <section class="tl" aria-label="All experiments">
    {years.map(g => (
      <div class="tl-year" data-year={g.y}>
        <h2>{g.y}<small data-yc>{plural(g.items.length)}</small></h2>
        <ol class="tl-list">
          {g.items.map(p => {
            const w = p.data, ext = !hasBody(p), href = experimentHref(p);
            return (
              <li class:list={['tl-item', { ext }]} data-type={w.type}>
                <a href={href} {...extAttrs(href)}>
                  <div>
                    <p class="tl-meta"><span class="tl-type">{w.type}</span><time datetime={w.date}>{fmtShort(w.date)}</time>{w.venue ? <span>{w.venue}</span> : w.readTime && <span>{w.readTime}</span>}</p>
                    <h3>{w.title}<DraftBadge draft={w.publish === 'Draft'} /></h3>{w.dek && <p>{w.dek}</p>}
                  </div>
                  <span class="tl-go" aria-hidden="true" set:html={ext ? EXT : CHEV} />{ext && <span class="sr">(opens external site)</span>}
                </a>
              </li>
            );
          })}
        </ol>
      </div>
    ))}
  </section>
  </Fragment>}
</main>
</Base>
