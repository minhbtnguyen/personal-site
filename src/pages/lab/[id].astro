---
/* One page per folder in src/content/experiments whose index.mdx has a body: copy
   a folder, rename it, and it gets its own page at /lab/<folder>/. */
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Code from '../../components/mdx/Code.astro';
import Figure from '../../components/mdx/Figure.astro';
import Formula from '../../components/mdx/Formula.astro';
import Note from '../../components/mdx/Note.astro';
import Output from '../../components/mdx/Output.astro';
import { getProjects, getExperiments, hasBody, projectHref, url, type Experiment } from '../../lib/content';
import { CHEV, extAttrs, figureHTML, fmtLong, Footnotes } from '../../lib/render';

export async function getStaticPaths() {
  const experiments = await getExperiments();
  return experiments.filter(hasBody).map(experiment => ({ params: { id: experiment.id }, props: { experiment } }));
}

interface Props { experiment: Experiment }
const { experiment } = Astro.props;
const w = experiment.data;
const proj = w.project && (await getProjects()).find(p => p.id === w.project!.id);
const { Content } = await render(experiment);

const notes = new Footnotes();
const figure = w.figure && figureHTML(w.figure, notes);
---
<Base title={w.title} description={w.dek} active="lab" notes={notes.list} type="article">
<main>
  <header class="a-head">
    <a class="crumb" href={url('lab/')}><Fragment set:html={CHEV} /> All experiments</a>
    <ul class="tags" aria-label="Type"><li>{w.type}</li></ul>
    <h1>{w.title}</h1>
    {w.dek && <p class="a-dek">{w.dek}</p>}
    <p class="d-meta sep"><time datetime={w.date}>{fmtLong(w.date)}</time>{w.readTime && <span>{w.readTime}</span>}</p>
    {proj && <div class="d-links"><a class="pill pill-alt" href={projectHref(proj)} {...extAttrs(projectHref(proj))}>Part of {proj.data.name}</a></div>}
  </header>
  {w.cover && <Image class="a-cover" src={w.cover.src} alt={w.cover.alt} widths={[740, 1480]} sizes="(max-width: 784px) 100vw, 740px" loading="eager" fetchpriority="high" />}
  {figure && <Fragment set:html={figure} />}
  <div class="body"><Content components={{ Code, Figure, Formula, Note, Output }} /></div>
</main>
</Base>
