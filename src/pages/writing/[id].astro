---
/* One page per folder in src/content/writings whose index.mdx has a body: copy
   a folder, rename it, and it gets its own page at /writing/<folder>/. */
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import More from '../../components/More.astro';
import Code from '../../components/mdx/Code.astro';
import Figure from '../../components/mdx/Figure.astro';
import Formula from '../../components/mdx/Formula.astro';
import Note from '../../components/mdx/Note.astro';
import Output from '../../components/mdx/Output.astro';
import { getProjects, getWritings, hasBody, projectHref, url, type Writing } from '../../lib/content';
import { CHEV, figureHTML, fmtLong, Footnotes } from '../../lib/render';

export async function getStaticPaths() {
  const writings = await getWritings();
  return writings.filter(hasBody).map(writing => ({ params: { id: writing.id }, props: { writing } }));
}

interface Props { writing: Writing }
const { writing } = Astro.props;
const w = writing.data;
const proj = w.project && (await getProjects()).find(p => p.id === w.project!.id);
const { Content } = await render(writing);

const notes = new Footnotes();
const figure = w.figure && figureHTML(w.figure, notes);
---
<Base title={w.title} description={w.dek} active="writing" notes={notes.list}>
<main>
  <header class="a-head">
    <a class="crumb" href={url('writing/')}><Fragment set:html={CHEV} /> All writings</a>
    <p class="a-kind"><span>{w.type}</span><time datetime={w.date}>{fmtLong(w.date)}</time>{w.readTime && <span>{w.readTime}</span>}</p>
    <h1>{w.title}</h1>
    {w.dek && <p class="a-dek">{w.dek}</p>}
    {proj && <div class="p-links"><More href={projectHref(proj)} label={`Part of ${proj.data.name}`} /></div>}
  </header>
  {w.cover && <Image class="a-cover" src={w.cover.src} alt={w.cover.alt} widths={[740, 1480]} sizes="(max-width: 784px) 100vw, 740px" loading="eager" />}
  {figure && <Fragment set:html={figure} />}
  <div class="body"><Content components={{ Code, Figure, Formula, Note, Output }} /></div>
</main>
</Base>
