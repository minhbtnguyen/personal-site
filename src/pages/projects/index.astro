---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Segmented from '../../components/Segmented.astro';
import { FILTER_MIN, SITE } from '../../data/site';
import { getProjects } from '../../lib/content';

const projects = await getProjects();
const cats = [...new Set(projects.map(p => p.data.category))];
---
<Base title="Projects" description={SITE.projectsPage.intro} active="projects">
<main>
  <PageHero title={SITE.projectsPage.title} intro={SITE.projectsPage.intro} />
  <div class="toolbar">
    {cats.length > 1 && projects.length >= FILTER_MIN ? <Segmented name="cat" values={cats} label="Filter projects by category" /> : <span></span>}
    <span class="count" id="count" aria-live="polite">{projects.length} projects</span>
  </div>
  <section class="pgrid" id="pgrid" aria-label="All projects">
    {projects.map(p => <ProjectCard project={p} />)}
    <p class="empty" id="empty" hidden>No projects in this category yet.</p>
  </section>
</main>
</Base>
