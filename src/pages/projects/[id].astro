---
/* One page per YAML file in src/content/projects: copy a file, rename it, and
   it gets its own page at /projects/<filename>/. */
import Base from '../../layouts/Base.astro';
import More from '../../components/More.astro';
import { getProjects, url, type Project } from '../../lib/content';
import { CHEV } from '../../lib/render';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map(project => ({ params: { id: project.id }, props: { project } }));
}

interface Props { project: Project }
const { project } = Astro.props;
const p = project.data;

const links = [
  p.links?.source && { url: p.links.source, label: 'Source' },
  p.links?.demo && { url: p.links.demo, label: 'Live demo' },
  p.links?.video && { url: p.links.video, label: 'Demo video' }
].filter((l): l is { url: string; label: string } => Boolean(l));
---
<Base title={p.name} description={p.tagline} active="projects">
<main>
  <header class="a-head">
    <a class="crumb" href={url('projects/')}><Fragment set:html={CHEV} /> All projects</a>
    <p class="a-kind"><span>{p.categories.join(' · ')}</span><span>{p.year}</span><span>{p.status}</span></p>
    <h1>{p.name}</h1>
    <p class="a-dek">{p.tagline}</p>
    {p.summary && <p class="p-summary">{p.summary}</p>}
    {links.length > 0 && <div class="p-links">{links.map(l => <More href={l.url} label={l.label} />)}</div>}
  </header>
</main>
</Base>
