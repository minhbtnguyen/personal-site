---
/* One page per YAML file in src/content/projects: copy a file, rename it, and
   it gets its own page at /projects/<filename>/. Projects that set `url` link
   out instead and get no page. */
import Base from '../../layouts/Base.astro';
import { getProjects, hasPage, url, type Project } from '../../lib/content';
import { AWARD, CHEV, extAttrs, statusClass } from '../../lib/render';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.filter(hasPage).map(project => ({ params: { id: project.id }, props: { project } }));
}

interface Props { project: Project }
const { project } = Astro.props;
const p = project.data;

const links = [
  p.links?.source && { url: p.links.source, label: 'Source' },
  p.links?.demo && { url: p.links.demo, label: 'Live demo' },
  p.links?.video && { url: p.links.video, label: 'Demo video' }
].filter((l): l is { url: string; label: string } => Boolean(l));
---
<Base title={p.name} description={p.tagline} active="projects">
<main>
  <header class="a-head">
    <a class="crumb" href={url('projects/')}><Fragment set:html={CHEV} /> All projects</a>
    <ul class="tags" aria-label="Categories">{p.categories.map(c => <li>{c}</li>)}</ul>
    <h1>{p.name}</h1>
    <p class="a-dek">{p.tagline}</p>
    <p class="d-meta"><span>{p.year}</span><span class:list={['status', statusClass(p.status)]}><i></i>{p.status}</span>{p.award && <span class="award"><Fragment set:html={AWARD} />{p.award}</span>}</p>
    {p.summary && <p class="p-summary">{p.summary}</p>}
    {p.stack && <ul class="chips p-stack" aria-label="Tech stack">{p.stack.map(t => <li>{t}</li>)}</ul>}
    {links.length > 0 && (
      <div class="d-links">{links.map((l, i) => <a class:list={['pill', { 'pill-alt': i > 0 }]} href={l.url} {...extAttrs(l.url)}>{l.label}</a>)}</div>
    )}
  </header>
</main>
</Base>
