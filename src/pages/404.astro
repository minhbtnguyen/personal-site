---
/* GitHub Pages serves this for any missing path under the site. */
import Base from '../layouts/Base.astro';
import More from '../components/More.astro';
import { url } from '../lib/content';
---
<Base title="Page not found" description="This page doesn't exist.">
<main>
  <section class="nf">
    <p class="kicker">404</p>
    <h1 class="h-xl">Page not found.</h1>
    <p class="nf-sub">The link may be old, or the page has moved.</p>
    <div class="cta-row">
      <a class="pill" href={url()}>Go home</a>
      <More href={url('projects/')} label="Projects" />
      <More href={url('writing/')} label="Writing" />
    </div>
  </section>
</main>
</Base>
